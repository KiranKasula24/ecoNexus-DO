# Browser-safe Supabase configuration. These values are required when building
# the Next.js image because NEXT_PUBLIC_* values are embedded in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_C7DXAS1zbdL4XxpIG2dyAg_0wcS6Y-2
# Compatibility alias for existing server routes; set it to the same value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_C7DXAS1zbdL4XxpIG2dyAg_0wcS6Y-2

# Server-only value. Store it in Jenkins Credentials or your local .env.local;
# never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_lgYER
zP26dofPSHxxCAsow_EEauJyUl

# Enables the existing Next.js scheduled agent route.
ENABLE_AGENT_CRON=true

# Set this to the public Render URL in Vercel, or localhost for local Node runs.
LANGGRAPH_AGENT_URL=http://localhost:8001

# Optional: omit GROQ_API_KEY to run LangGraph in deterministic demo mode.
AGENT_OFFER_VISIBILITY=local
AGENT_REQUEST_VISIBILITY=local
